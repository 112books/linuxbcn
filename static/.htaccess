ErrorDocument 404 /ca/404.html

# ─── Redirects des de WordPress (301 per preservar SEO) ──────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Totes les destinacions són absolutes amb https:// — darrere del proxy SSL de
  # Dinahosting, Apache veu http i convertiria les relatives en http://linuxbcn.com/...

  # www → sense www (canonical)
  RewriteCond %{HTTP_HOST} ^www\.linuxbcn\.com [NC]
  RewriteRule ^(.*)$ https://linuxbcn.com/$1 [R=301,L]

  # Directori sense barra final → amb barra (substitueix el 301 de mod_dir, que sortia en http)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ https://linuxbcn.com/$1/ [R=301,L]

  # ?p=123, ?page_id=… (permalinks antics de WordPress)
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|author)=[0-9]+
  RewriteRule ^(index\.php)?$ https://linuxbcn.com/ca/ [R=301,L,QSD]

  # Arrel → versió catalana
  RewriteRule ^$ https://linuxbcn.com/ca/ [R=301,L]

  # Bloqueig i redirect d'URLs de WordPress
  RewriteRule ^wp-admin(.*)$        https://linuxbcn.com/ca/ [R=301,L]
  RewriteRule ^wp-login\.php$       https://linuxbcn.com/ca/ [R=301,L]
  RewriteRule ^wp-cron\.php$        - [F,L]
  RewriteRule ^xmlrpc\.php$         - [F,L]
  RewriteRule ^wp-content/(.*)$     https://linuxbcn.com/ca/ [R=301,L]
  RewriteRule ^wp-includes/(.*)$    - [F,L]

  # Projectes del WordPress (/slug/, /clients/slug/, /client/slug/, /content/slug/) → projecte actual
  RewriteRule ^(?:(?:clients?|content)/)?(?:112books|112-books|112books-eu)/?$            https://linuxbcn.com/ca/projectes/112books/ [R=301,L,NC]
  RewriteRule ^(?:(?:clients?|content)/)?9-barris-acull/?$                                https://linuxbcn.com/ca/projectes/9-barris-acull/ [R=301,L,NC]
  RewriteRule ^(?:(?:clients?|content)/)?a-w-p-c-p-around-the-worlds-pinhole-crazy-people/?$ https://linuxbcn.com/ca/projectes/awpcp/ [R=301,L,NC]
  RewriteRule ^(?:(?:clients?|content)/)?blog-pocallum-cat/?$                             https://linuxbcn.com/ca/projectes/blog-pocallum/ [R=301,L,NC]
  RewriteRule ^(?:(?:clients?|content)/)?(?:machiroku|machiroku-com)/?$                   https://linuxbcn.com/ca/projectes/machiroku/ [R=301,L,NC]
  RewriteRule ^(?:(?:clients?|content)/)?family-art-tattoo/?$                             https://linuxbcn.com/ca/projectes/family-art-tattoo/ [R=301,L,NC]
  RewriteRule ^(?:(?:clients?|content)/)?llumatics/?$                                     https://linuxbcn.com/ca/projectes/llumatics/ [R=301,L,NC]
  RewriteRule ^(?:(?:clients?|content)/)?nau-bostik/?$                                    https://linuxbcn.com/ca/projectes/nau-bostik/ [R=301,L,NC]
  RewriteRule ^(?:(?:clients?|content)/)?(?:favb|favb-cat)/?$                             https://linuxbcn.com/ca/projectes/favb/ [R=301,L,NC]
  RewriteRule ^(?:(?:clients?|content)/)?(?:carrer|revista-carrer)/?$                     https://linuxbcn.com/ca/projectes/carrer/ [R=301,L,NC]
  RewriteRule ^(?:(?:clients?|content)/)?bratia/?$                                        https://linuxbcn.com/ca/projectes/bratia/ [R=301,L,NC]
  RewriteRule ^(?:(?:clients?|content)/)?malditasmaquinas/?$                              https://linuxbcn.com/ca/malditasmaquinas/ [R=301,L,NC]
  RewriteRule ^(?:(?:clients?|content)/)?konsento/?$                                      https://linuxbcn.com/en/projectes/konsento/ [R=301,L,NC]

  # Pàgines antigues conegudes de WordPress → equivalents Hugo
  RewriteRule ^qui-som/?$           https://linuxbcn.com/ca/qui-som/ [R=301,L]
  RewriteRule ^about/?$             https://linuxbcn.com/en/qui-som/ [R=301,L]
  RewriteRule ^(?:contacte|contacteu)/?$ https://linuxbcn.com/ca/contacte/ [R=301,L]
  RewriteRule ^contact(/.*)?$       https://linuxbcn.com/en/contacte/ [R=301,L]
  RewriteRule ^projectes/?$         https://linuxbcn.com/ca/projectes/ [R=301,L]
  RewriteRule ^projects/?$          https://linuxbcn.com/en/projectes/ [R=301,L]
  RewriteRule ^services/?$          https://linuxbcn.com/en/solucions/ [R=301,L]
  RewriteRule ^(?:serveis|servei-tecnic|assessorament-tecnologic|assessorament-tecnol%C3%B2gic)/?$ https://linuxbcn.com/ca/solucions/ [R=301,L,NC]
  RewriteRule ^content/(?:serveis|servei-t.*|assessorament-.*|hostatjament-mida|instal.*|maquinari|programari|formaci.*|registre-de-dominis|intranet-extranet|promoci.*)/?$ https://linuxbcn.com/ca/solucions/ [R=301,L,NC]

  # Seccions genèriques del WordPress → seccions equivalents Hugo
  RewriteRule ^category/projectes(/.*)?$  https://linuxbcn.com/ca/projectes/ [R=301,L]
  RewriteRule ^(?:clients?|content|corp)(/.*)?$ https://linuxbcn.com/ca/projectes/ [R=301,L,NC]
  RewriteRule ^(?:category|tag|author|blog)(/.*)?$ https://linuxbcn.com/ca/ [R=301,L]
  RewriteRule ^page/[0-9]+/?$             https://linuxbcn.com/ca/ [R=301,L]
  RewriteRule ^[0-9]{4}(/.*)?$            https://linuxbcn.com/ca/ [R=301,L]
  RewriteRule ^feed(/.*)?$                https://linuxbcn.com/ca/index.xml [R=301,L]

  # Instal·lacions antigues (galeria /fotos, Drupal, /linuxbcn/, /es/…) → portada
  RewriteRule ^(?:fotos?|drupal|linuxbcn|joan|kristina|es|index\.php|bofh|wptest)(/.*)?$ https://linuxbcn.com/ca/ [R=301,L,NC]

  # Qualsevol altre slug d'un sol nivell que no existeix (posts antics del WP) → portada
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^/.]+)/?$ https://linuxbcn.com/ca/ [R=301,L]
</IfModule>

# ─── Security Headers ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"

  # CSP: sense 'unsafe-inline' (scripts i estils en linia externalitzats)
  # GoatCounter via proxy first-party /v/index.php (mateix origen)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

  Header always unset X-Powered-By
  Header always unset Server
</IfModule>

# ─── Desactiva llistat de directoris ─────────────────────────────────────────
Options -Indexes

# ─── Protegeix fitxers sensibles ─────────────────────────────────────────────
<FilesMatch "(^\.htaccess|CLAUDE\.md|AGENTS\.md|\.toml|\.env)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ─── Compressió ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ─── Caché d'assets estàtics ─────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ─── No cachejar analytics-cache.json (dades dinàmiques) ────────────────────
<Files "analytics-cache.json">
  Header set Cache-Control "no-store, no-cache, must-revalidate"
  Header set Pragma "no-cache"
  Header unset ETag
</Files>

# ─── HTML sempre fresc (evita que el proxy serveixi versions antigues) ──────
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
